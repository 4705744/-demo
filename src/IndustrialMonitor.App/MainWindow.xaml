<Window x:Class="IndustrialMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IndustrialMonitor.App.Controls"
        Title="Generic Industrial Monitor Demo"
        Width="1380" Height="860" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="设备监控中心" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="通用工业上位机演示 · 实时采集 / 趋势 / 报警 / 历史" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ConnectionDot}" Foreground="{StaticResource AccentBrush}" FontSize="18" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding ConnectionState}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="通信方式" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="IP / Host" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/><TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="端口" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/><TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <Button Grid.Column="3" Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" VerticalAlignment="Bottom"/>
                <TextBlock Grid.Column="4" Text="模拟设备模式无需外部硬件；TCP JSON 可接入自定义测试服务器。" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,16,16,0" TextWrapping="Wrap"/>
                <Button Grid.Column="5" Content="打开数据目录" Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Bottom" Background="#D7E6EE"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="240"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Columns="5">
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="温度" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Temperature, StringFormat={}{0:0.0} °C}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="压力" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Pressure, StringFormat={}{0:0.000} MPa}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="转速" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Speed, StringFormat={}{0:0} rpm}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="振动" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Vibration, StringFormat={}{0:0.00} mm/s}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="产量计数" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding ProductionCount}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                </UniformGrid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="温度实时趋势" FontSize="17" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding LastUpdate}" Foreground="{StaticResource MutedTextBrush}"/></Grid>
                        <controls:TrendChart Grid.Row="1" Values="{Binding TemperatureTrend}" Margin="0,10,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="历史采样" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding History}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="100"/>
                                <DataGridTextColumn Header="温度 °C" Binding="{Binding Temperature, StringFormat=0.0}" Width="90"/>
                                <DataGridTextColumn Header="压力 MPa" Binding="{Binding Pressure, StringFormat=0.000}" Width="95"/>
                                <DataGridTextColumn Header="转速 rpm" Binding="{Binding Speed, StringFormat=0}" Width="95"/>
                                <DataGridTextColumn Header="振动 mm/s" Binding="{Binding Vibration, StringFormat=0.00}" Width="100"/>
                                <DataGridTextColumn Header="产量" Binding="{Binding ProductionCount}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="1.05*"/><RowDefinition Height="0.95*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="报警记录" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="温度 > 75°C / 压力 > 0.85MPa / 振动 > 6.5mm/s" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,10"/></StackPanel><Button Grid.Column="1" Content="确认全部报警" Command="{Binding AcknowledgeAllCommand}" VerticalAlignment="Top" Padding="12,7"/></Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Alarms}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="85"/><DataGridTextColumn Header="等级" Binding="{Binding Level}" Width="75"/><DataGridTextColumn Header="点位" Binding="{Binding Metric}" Width="65"/><DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="*"/><DataGridCheckBoxColumn Header="确认" Binding="{Binding IsAcknowledged}" Width="55"/></DataGrid.Columns></DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="运行日志" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/><ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="#101B27" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="12"/></Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
